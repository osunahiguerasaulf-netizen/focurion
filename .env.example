# Puerto local. En Render/Railway/etc. el proveedor normalmente inyecta PORT.
PORT=3000
NODE_ENV=development
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# MySQL local (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=focurion
DB_SKIP_CREATE=false

# Hosting remoto: cambia los valores anteriores por los que te dé tu proveedor.
# En remoto Focurion NO intenta ejecutar CREATE DATABASE; sí crea las tablas dentro
# de la base indicada por DB_NAME.
# DB_HOST=mysql-proveedor.example.com
# DB_PORT=3306
# DB_USER=usuario_remoto
# DB_PASSWORD=contraseña_remota
# DB_NAME=focurion
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CONNECTION_LIMIT=5

# Opcional: envío real de códigos para recuperar contraseña.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
